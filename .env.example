# Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://forex:forex@localhost:5432/forex
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:3000
# Set both before starting Compose; the first admin password must be at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Live trading is always disabled unless explicitly changed by an administrator.
LIVE_TRADING_ENABLED=false

# MT5 demo handoff. Generate a Fernet key and a long random worker token.
MT5_ENCRYPTION_KEY=
MT5_WORKER_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend
# Browser calls use the same-origin Next.js API proxy.
